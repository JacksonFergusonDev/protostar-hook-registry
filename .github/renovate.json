{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base"
  ],
  "enabledManagers": [
    "pre-commit"
  ],
  "pre-commit": {
    "enabled": true,
    "fileMatch": [
      "(^|/)hooks\\.ya?ml$"
    ]
  },
  "automerge": true,
  "automergeType": "branch",
  "branchConcurrentLimit": 0,
  "prConcurrentLimit": 0,
  "schedule": [
    "at any time"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "pre-commit"
      ],
      "automerge": true,
      "minimumReleaseAge": "1 day"
    }
  ]
}
